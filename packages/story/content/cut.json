      "id": "quarry.cut",
      "world": "quarry",
      "title": "Open the cage",
      "kind": "main",
      "steps": [
        {
          "id": "ledge",
          "objective": "Clear the Blots: `dd` on the ledge, then `u`.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "cut.far"
