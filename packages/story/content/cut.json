{
  "worlds": [],
  "quests": [
    {
      "id": "quarry.cut",
      "world": "quarry",
      "title": "A cry in the Cut",
      "kind": "main",
      "steps": [
        {
          "id": "ledge",
          "objective": "Get past the Blots on the ledge.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "cut.far"
          },
          "then": []
        },
        {
          "id": "dot",
          "objective": "Open the cage at the end of the ledge.",
          "completeWhen": {
            "type": "flag",
            "flag": "cut.dot-free",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "cut.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "Below the road, the Cut: one ledge\nover a long drop. Something is crying."
        }
      ],
      "then": []
    },
    {
      "id": "cut.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "dd deletes the line you stand on,\nand everything on it."
        },
        {
          "speaker": "scribe",
          "text": "Cut too much? u undoes your last change.\nThe land comes back. What you cut does not."
        },
        {
          "speaker": "scribe",
          "text": "Three of them sit on the cage itself.\nYou cannot step through that. Delete it."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "cut.knows-dd",
          "value": true
        },
        {
          "type": "set-flag",
          "flag": "cut.knows-u",
          "value": true
        }
      ]
    },
    {
      "id": "cut.ledge",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots pour onto the ledge.\nThey crawl toward you, along your line."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "spawn",
              "entity": {
                "id": "cut.blot-0",
