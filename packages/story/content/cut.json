          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "cut.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Cut: a ledge over a long drop. Someone is\ncrying in a cage at the far end. Reach it."
        }
      ],
      "then": []
    },
    {
      "id": "cut.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "That cage is mine. I drew something small in\nit and never came back to finish."
        },
        {
          "speaker": "scribe",
          "text": "I always did that. Start a page, leave it\nunsaved, swear I'll be back by morning."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "cut.knows-dd",
          "value": true
        },
        {
          "type": "set-flag",
          "flag": "cut.knows-u",
          "value": true
        }
      ]
    },
    {
      "id": "cut.ledge",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots pour onto the ledge, crawling along\nyour row. Nowhere to run."
        },
        {
          "speaker": "system",
          "text": "Press `dd`: your row, Blots and all, is wiped.\nThen `u`: the ledge comes back, they don't."
        }
      ],
      "then": [
        {
