                "sprite": "blot",
                "at": {
                  "line": 5,
                  "col": 28
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cut.dot",
      "lines": [
        {
          "speaker": "npc",
          "text": "...out?",
          "name": "???"
        },
        {
          "speaker": "system",
          "text": "You open the cage. A small ink dot\nhops out and looks up at you."
        },
        {
          "speaker": "npc",
          "text": "Again. ...again.",
          "name": "Dot"
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "set-flag",
              "flag": "cut.dot-free",
              "value": true
            },
            {
              "type": "remove-entity",
              "entity": "dot-caged"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "dot",
                "kind": "npc",
                "sprite": "dot",
                "at": {
                  "line": 4,
                  "col": 29
                },
                "behaviour": {
