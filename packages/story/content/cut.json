    {
      "id": "quarry.cut",
      "world": "quarry",
      "title": "Open the cage",
      "kind": "main",
      "steps": [
        {
          "id": "ledge",
          "objective": "Cross the ledge. Stand on it: dd deletes the Blots' row, u brings the ledge back.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "cut.far"
          },
          "then": []
        },
        {
          "id": "dot",
          "objective": "Walk to the cage at the end of the ledge. Press Enter next to it.",
          "completeWhen": {
            "type": "flag",
            "flag": "cut.dot-free",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "cut.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Cut: a ledge over a long drop. Someone is\ncrying at the far end. Cross it."
        }
      ],
      "then": []
    },
    {
      "id": "cut.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: dd deletes the row you stand on, and\neverything on it. Blots included."
        },
        {
          "speaker": "scribe",
          "text": "Note: u undoes your last change. The ledge\ncomes back. The Blots do not."
        },
        {
          "speaker": "scribe",
          "text": "Three Blots sit on the cage. Delete their row\nwith dd, then press u to rebuild the ledge."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "cut.knows-dd",
          "value": true
        },
        {
          "type": "set-flag",
          "flag": "cut.knows-u",
          "value": true
        }
      ]
    },
    {
      "id": "cut.ledge",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots pour onto the ledge, crawling along your\nrow. Delete the row (dd), then undo (u)."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
