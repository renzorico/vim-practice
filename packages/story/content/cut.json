    {
      "id": "cut.dot",
      "lines": [
        {
          "speaker": "npc",
          "text": "...out?",
          "name": "???"
        },
        {
          "speaker": "system",
          "text": "The cage opens. A small ink dot hops out\nand looks up at you."
        },
        {
          "speaker": "npc",
          "text": "Again. ...again.",
          "name": "Dot"
