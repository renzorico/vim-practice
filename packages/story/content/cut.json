                },
                "every": 1,
                "damage": 0,
                "solid": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "cut.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "dd from the ledge's west end deletes\nthe Blots' line. u brings the ledge back."
        }
      ],
      "then": []
    },
    {
      "id": "cut.end",
      "lines": [
        {
          "speaker": "system",
          "text": "Dot follows you down into the Quarry.\nBelow, the sound of stone on stone."
        }
      ],
      "then": []
    }
