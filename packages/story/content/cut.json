                  "col": 24
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "cut.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 5,
                  "col": 26
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "cut.blot-3",
