{
  "worlds": [
    {
      "id": "wordwood",
      "order": 3,
      "name": "The Wordwood",
      "stages": [
        "canopy",
        "glades",
        "gates",
        "manifest"
      ],
      "castle": "gates",
      "statue": "R"
    }
  ],
  "openingStage": "canopy",
  "openingQuests": [],
  "quests": [
    {
      "id": "wordwood.ferry",
      "world": "wordwood",
      "title": "Cross the canopy",
      "kind": "main",
      "steps": [
        {
          "id": "canopy",
          "objective": "Cross the cut bridges: `fH` jumps to the next ladder.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "canopy.tier-c"
          },
          "then": []
        },
        {
          "id": "lift",
          "objective": "Ride the lift: `;` stops short of the thorns again, then `Enter`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "canopy"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "canopy.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Wordwood. You need the ferry, but the\nUnwriter cut every bridge in the canopy."
        },
        {
          "speaker": "system",
          "text": "Talk to Fern: stand next to her, press `Enter`.\nShe knows a way across."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.fern",
      "lines": [
        {
          "speaker": "npc",
          "text": "The Unwriter cut every bridge I ever built.\nDon't walk off the end. The ground's far down.",
          "name": "Fern"
        },
        {
          "speaker": "system",
          "text": "On your row, press `fH`: land on the ladder.\nKnots work too: `f*`, then `;` for the next."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-f",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.fern-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "It cut every bridge and never looked down.\nKeep your eyes up here, child.",
          "name": "Fern"
        }
      ],
      "then": []
    },
    {
      "id": "canopy.tier-b",
      "lines": [
        {
          "speaker": "npc",
          "text": "Back! ...back.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Overshot a jump? Press `,`: it repeats your\nlast `f` backward. `;` repeats it forward."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-repeat",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.crack",
      "lines": [
        {
          "speaker": "system",
          "text": "Through a knothole: the same wood, but saplings.\nNo canopy. No bridges to cut."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Thorns past the gap: press `t@` to stop one\ntile short. `f@` is blocked."
        },
        {
          "speaker": "system",
          "text": "Thorns again past the lift, below. `;`\nrepeats your `t@`: it stops you on the lift."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-t",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.lift",
      "lines": [
        {
          "speaker": "system",
          "text": "The lift creaks. Down through the leaves,\ninto the glades."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Don't walk the gaps. `fH` jumps to the ladder.\n`t@` stops one tile before the thorns."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "canopy.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Below the canopy, the glades. Someone down\nthere is counting. Out loud. Every glade."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "wordwood.start",
      "when": {
        "type": "stage-cleared",
        "stage": "ledger"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "wordwood.ferry"
        }
      ]
    },
    {
      "id": "canopy.edge",
      "when": {
        "type": "trigger",
        "trigger": "canopy.edge"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.fern"
        }
      ],
      "unless": "canopy.knows-f"
    },
    {
      "id": "canopy.fern",
      "when": {
        "type": "trigger",
        "trigger": "canopy.talk-fern"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.fern"
        }
      ],
      "unless": "canopy.knows-f"
    },
    {
      "id": "canopy.fern-again",
      "when": {
        "type": "trigger",
        "trigger": "canopy.talk-fern"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.fern-again"
        }
      ],
      "onlyIf": "canopy.knows-f"
    },
    {
      "id": "canopy.tier-b",
      "when": {
        "type": "trigger",
        "trigger": "canopy.tier-b"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.tier-b"
        }
      ]
    },
    {
      "id": "canopy.crack",
      "when": {
        "type": "trigger",
        "trigger": "canopy.talk-crack"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.crack"
        }
      ]
    },
    {
      "id": "canopy.tier-c",
      "when": {
        "type": "trigger",
        "trigger": "canopy.tier-c"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.note"
        }
      ]
    },
    {
      "id": "canopy.note",
      "when": {
        "type": "trigger",
        "trigger": "canopy.talk-note"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.note"
        }
      ]
    },
    {
      "id": "canopy.lift",
      "when": {
        "type": "trigger",
        "trigger": "canopy.talk-lift"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "canopy.lift"
        },
        {
          "type": "set-flag",
          "flag": "canopy.down",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.end",
      "when": {
        "type": "stage-cleared",
        "stage": "canopy"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "canopy.end"
        }
      ]
    }
  ]
}
