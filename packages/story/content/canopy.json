  "quests": [
    {
      "id": "wordwood.ferry",
      "world": "wordwood",
      "title": "The canopy road",
      "kind": "main",
      "steps": [
        {
          "id": "canopy",
          "objective": "Cross the canopy.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "canopy.tier-c"
          },
          "then": []
        },
        {
          "id": "lift",
          "objective": "Take the lift down.",
