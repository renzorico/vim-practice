  "openingStage": "canopy",
  "openingQuests": [],
  "quests": [
    {
      "id": "wordwood.ferry",
      "world": "wordwood",
      "title": "Cross the canopy",
      "kind": "main",
      "steps": [
        {
          "id": "canopy",
          "objective": "Cross the cut bridges. f and a letter jumps to it: fH reaches the ladder.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "canopy.tier-c"
          },
          "then": []
        },
        {
          "id": "lift",
          "objective": "Walk to the lift at the end and press Enter next to it.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "canopy"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "canopy.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Wordwood, a forest grown from words. The\nUnwriter cut the bridges. Cross the canopy."
        },
        {
          "speaker": "system",
          "text": "Don't walk the gaps. Talk to Fern: she knows a\nfaster way across."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.fern",
      "lines": [
        {
          "speaker": "npc",
          "text": "Don't walk off the end. It's a long way\ndown, and the ground doesn't forgive.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "Up here we don't walk the gaps. f and a letter\njumps you to the next one on your row.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "See the ladder at the far end? Press fH. The\ngaps don't matter, only where you land.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "Knots work too: f* jumps to the next knot (*),\nand ; repeats the find for the one after.",
          "name": "Fern"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-f",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.fern-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "The Unwriter cut every bridge and never looked\ndown. I don't think it could. Press fH, child.",
          "name": "Fern"
        }
      ],
      "then": []
    },
    {
      "id": "canopy.tier-b",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: , repeats your last f backward. ; repeats\nit forward. Overshot? Press , to step back."
        },
        {
          "speaker": "npc",
          "text": "Back! ...back.",
          "name": "Dot"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-repeat",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.crack",
      "lines": [
        {
          "speaker": "system",
          "text": "Through a knothole: the same wood,\nbut saplings. No canopy at all."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: thorns (@) past the gap. f@ lands you in\nthem. t@ stops one tile short. Use t@."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-t",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.lift",
      "lines": [
        {
          "speaker": "system",
          "text": "The lift creaks. Down through the leaves,\ninto the glades."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Don't walk the gaps. f then a letter jumps: fH\nfor the ladder, t@ to stop before the thorns."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "canopy.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Below the canopy, the glades. Something down\nthere is counting. Out loud."
          }
        }
      ],
      "then": []
    }
  ],
