            "stage": "canopy"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "canopy.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "West of the Quarry, the Wordwood.\nA forest grown from words."
        },
        {
          "speaker": "system",
          "text": "The road runs through the branches.\nThe rope bridges are cut."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.fern",
      "lines": [
        {
          "speaker": "npc",
          "text": "Don't walk off the end. It's a long way\ndown, and the ground doesn't forgive.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "Up here we don't walk. We find.\nf and a letter: you're on the next one.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "See the ladder at the far end? fH.\nThe gaps don't matter. Only where you land.",
          "name": "Fern"
        },
        {
          "speaker": "npc",
          "text": "Knots work too. f* to the next knot,\nand ; finds the one after that.",
          "name": "Fern"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-f",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.fern-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "The Unwriter cut every bridge. Didn't\nlook down once. I don't think it could.",
          "name": "Fern"
        }
      ],
      "then": []
    },
    {
      "id": "canopy.tier-b",
      "lines": [
        {
          "speaker": "npc",
          "text": "Back! ...back.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Dot means: , runs your last find\nbackwards. ; runs it forwards again."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-repeat",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.crack",
      "lines": [
        {
          "speaker": "system",
          "text": "Through a knothole: the same wood,\nbut saplings. No canopy at all."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Thorns past the gap. f@ would land you\nin them. t stops one short: t@."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "canopy.knows-t",
          "value": true
        }
      ]
    },
    {
      "id": "canopy.lift",
      "lines": [
        {
          "speaker": "system",
          "text": "The lift creaks. Down through the leaves,\ninto the glades."
        }
      ],
      "then": []
    },
    {
      "id": "canopy.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Don't walk the gaps. f jumps to a letter:\nfH for the ladder, t@ to stop short."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "canopy.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Below the canopy, the glades.\nSomething down there is counting paragraphs."
          }
        }
      ],
      "then": []
    }
