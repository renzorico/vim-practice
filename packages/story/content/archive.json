      "id": "archive.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Archive. Each shelf is a block of rows,\nwith an empty row between shelves."
        },
        {
          "speaker": "npc",
          "name": "Index",
          "text": "Oh good, hands. I'm Index. The shelf you're on\nis misfiled. It goes after the bibles."
        },
        {
          "speaker": "npc",
          "name": "Index",
          "text": "dap lifts the whole shelf, empty row and all.\nThen copy the atlases: yap, P above the rail."
        }
      ],
      "then": []
    },
    {
      "id": "archive.filed",
      "lines": [
        {
          "speaker": "npc",
          "name": "Index",
          "text": "Atlases, bibles, the misfiled shelf, and a copy\nby the door. In order, for once."
        }
      ],
      "then": []
    }
  ],
