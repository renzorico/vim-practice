  "dialogues": [
    {
      "id": "harbour.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "Cleat",
          "text": "Harbourmaster Cleat. The ledger says the clerk\nruns the port. Lighthouse order goes on top."
        },
        {
          "speaker": "scribe",
          "text": "Note: c deletes and leaves you typing.\ncw: a word. ct,: up to the comma. C: to the end."
        },
        {
          "speaker": "scribe",
          "text": "Note: P puts a row above you. yy copies a row.\nddp swaps a row with the one below it."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "harbour.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Cleat",
            "text": "Real crates. A ferry today. Rope for the\nLighthouse. The port's word again."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Ream",
            "text": "And the clerk? He's copying the ledger.\nThe right one, this time."
