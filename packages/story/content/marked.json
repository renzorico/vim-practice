{
  "worlds": [],
  "openingStage": "marked",
  "openingQuests": [],
  "quests": [
    {
      "id": "caves.marked",
      "world": "echo-caves",
      "title": "Fetch crystal and oil",
      "kind": "main",
      "steps": [
        {
          "id": "fetch",
          "objective": "Mark `ma`. Walk the tunnel to the crystal. `'a` for the oil, `` `a `` home.",
          "completeWhen": {
            "type": "flag",
            "flag": "marked.both",
            "value": true
          },
          "then": []
        },
        {
          "id": "echo",
          "objective": "Give them to the Echo: next to it, `Enter`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "marked"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "marked.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "A fork in the tunnel. Too dark to search.\nYou need a crystal and lamp oil."
        },
        {
          "speaker": "system",
          "text": "At the fork, press `ma`: it marks the spot.\nLater, `` `a `` brings you back from anywhere."
        },
        {
          "speaker": "system",
          "text": "`'a` goes to the start of the marked line:\nthe oil is there. `` `a `` is the exact spot."
        },
        {
          "speaker": "system",
          "text": "The crystal is at the end of the tunnel.\nWalk there; the mark will bring you home."
        }
      ],
      "then": []
    },
    {
      "id": "marked.got-crystal",
      "lines": [
        {
          "speaker": "system",
          "text": "A crystal, warm in your hand."
        }
      ],
      "then": []
    },
    {
      "id": "marked.got-oil",
      "lines": [
        {
          "speaker": "system",
          "text": "Lamp oil. Enough for a long dark."
        }
      ],
      "then": []
    },
    {
      "id": "marked.echo-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "...crystal. ...oil. Mark, then go."
        }
      ],
      "then": []
    },
    {
      "id": "marked.echo-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "Light, and oil to keep it. Now you can\nface the labyrinth."
        },
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "It hunts by walking. You don't have to."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "marked.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "marked.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Below, the labyrinth. Something heavy\nis walking its corridors."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "marked.start",
      "when": {
        "type": "stage-cleared",
        "stage": "gallery"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "caves.marked"
        }
      ]
    },
    {
      "id": "marked.crystal",
      "when": {
        "type": "trigger",
        "trigger": "marked.crystal"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "marked.got-crystal"
        },
        {
          "type": "set-flag",
          "flag": "marked.crystal",
          "value": true
        }
      ]
    },
    {
      "id": "marked.oil",
      "when": {
        "type": "trigger",
        "trigger": "marked.oil"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "marked.got-oil"
        },
        {
          "type": "set-flag",
          "flag": "marked.oil",
          "value": true
        }
      ]
    },
    {
      "id": "marked.echo-wait",
      "when": {
        "type": "trigger",
        "trigger": "marked.talk-echo"
      },
      "unless": "marked.both",
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "marked.echo-wait"
        }
      ]
    },
    {
      "id": "marked.echo-through",
      "when": {
        "type": "trigger",
        "trigger": "marked.talk-echo"
      },
      "onlyIf": "marked.both",
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "marked.echo-through"
        }
      ]
    },
    {
      "id": "marked.both-crystal",
      "when": {
        "type": "flag",
        "flag": "marked.crystal",
        "value": true
      },
      "onlyIf": "marked.oil",
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "marked.both",
          "value": true
        }
      ]
    },
    {
      "id": "marked.both-oil",
      "when": {
        "type": "flag",
        "flag": "marked.oil",
        "value": true
      },
      "onlyIf": "marked.crystal",
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "marked.both",
          "value": true
        }
      ]
    },
    {
      "id": "marked.end",
      "when": {
        "type": "stage-cleared",
        "stage": "marked"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "marked.end"
        }
      ]
    }
  ]
}
