      "id": "ledger.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "The Mason",
          "text": "My ledger is wrong. Strike out the walls, mark\nthe crew paid, and add a door at the end."
        },
        {
          "speaker": "npc",
          "name": "The Mason",
          "text": "o opens a row below: type, then press Esc.\nD cuts from the cursor to the end of a row."
        },
        {
          "speaker": "npc",
          "name": "The Mason",
          "text": "The rest you know: dd, x, r, and the dot.\nWalls I know. Doors, I'm still learning."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "ledger.knows-o",
          "value": true
        }
      ]
    }
