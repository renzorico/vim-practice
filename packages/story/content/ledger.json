{
  "worlds": [],
  "quests": [
    {
      "id": "quarry.ledger",
      "world": "quarry",
      "title": "Fix the Mason's ledger",
      "kind": "main",
      "steps": [
        {
          "id": "ledger",
          "objective": "Fix the ledger: `i`, `A`, `dd`, `x`, `a`, `D`, `o`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "ledger"
          },
          "then": []
        }
      ]
    }
  ],
  "reactions": [
    {
      "id": "ledger.start",
      "when": {
        "type": "stage-cleared",
        "stage": "shaft"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "quarry.ledger"
        },
        {
          "type": "unlock-stage",
          "stage": "ledger"
        }
      ]
    },
    {
      "id": "ledger.cleared",
      "when": {
        "type": "stage-cleared",
        "stage": "ledger"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "ledger.end"
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "ledger.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "The Mason",
          "text": "My ledger's wrong. Strike the walls, mark the\ncrew paid, add a door at the end. A door!"
        },
        {
          "speaker": "system",
          "text": "Start at the top. On a wall row, press `dd`:\nthe row is struck out. Work down from there."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "ledger.knows-o",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "ledger.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "The crew is paid, the plan has a door. Beyond\nthe quarry: a forest with every bridge cut."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "End of World 2."
          }
        }
      ],
      "then": []
    }
  ]
