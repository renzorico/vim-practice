      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "last.page"
        }
      ]
    },
    {
      "id": "last.whole",
      "when": {
        "type": "trigger",
        "trigger": "last.whole"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "last.whole"
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "unwriter"
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "last.whole",
          "value": true
        }
      ]
    },
    {
      "id": "last.door-r",
      "when": {
        "type": "trigger",
