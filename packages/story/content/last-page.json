  ],
  "dialogues": [
    {
      "id": "last.whole",
      "lines": [
        {
          "speaker": "system",
          "text": "The page is whole. The grey thing stops.\nThe Scribe is reading every word."
        }
      ],
      "then": []
    },
    {
      "id": "last.door-r",
      "lines": [
        {
          "speaker": "system",
          "text": "Recover. The Scribe's finger moves to R.\nNow write it, so it stays: :w"
        }
      ],
      "then": []
    },
    {
      "id": "last.dialog-returns",
      "lines": [
        {
          "speaker": "system",
          "text": "Nothing is decided.\nThe dialog returns."
        }
      ],
      "then": []
    },
    {
      "id": "last.not-yet",
      "lines": [
        {
          "speaker": "system",
          "text": "That door is drawn, but not yet hinged."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "last-page.intro",
      "beats": [
        {
          "type": "terminal",
          "lines": [
            "E325: ATTENTION",
            "Found a swap file by the name \".folio.txt.swp\"",
            "[O]pen Read-Only, (E)dit anyway, (R)ecover, (D)elete it, (Q)uit, (A)bort:"
          ]
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "The Scribe is back. The file is open.\nAnd the page you stand on is a question."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Dot",
            "text": "Attention. ...attention."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Something grey is tearing at the bottom\nof the page. Tidying up."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "u brings back what it tears. But u takes\nback the last change, whoever made it."
          }
        }
      ],
      "then": []
    },
    {
      "id": "last.recover",
      "beats": [
        {
          "type": "terminal",
          "lines": [
            "\"folio.txt\" 4096L written"
          ]
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Dot",
            "text": "Saved. ...saved."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "You are not erased. You are written."
          }
        },
        {
          "type": "title",
          "text": "UNSAVED"
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Thank you for playing."
          }
        }
      ],
      "then": [
        {
          "type": "ending",
          "ending": "recover"
        }
      ]
    },
    {
      "id": "last.delete",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Delete. The page folds back to the Margin."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "The Elder stands alone at the festival,\nwaiting for a ferry that was never written."
          }
        }
      ],
      "then": [
        {
          "type": "ending",
          "ending": "delete"
        }
      ]
    }
  ]
}
