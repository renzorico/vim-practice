{
  "worlds": [],
  "openingStage": "warehouse",
  "openingQuests": [],
  "quests": [
    {
      "id": "port.warehouse",
      "world": "copper-port",
      "title": "Stock the shelves",
      "kind": "main",
      "steps": [
        {
          "id": "stock",
          "objective": "Stock the shelves: `yw`, then `p` on each.",
          "completeWhen": {
            "type": "flag",
            "flag": "warehouse.stocked",
            "value": true
          },
          "then": []
        },
        {
          "id": "ream",
          "objective": "Talk to Ream: next to him, `Enter`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "warehouse"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "warehouse.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The warehouse. You need three bare shelves\nstocked: oil on top and middle, rope below."
        },
        {
          "speaker": "system",
          "text": "Stand on the tally word. Press `yw`.\nThen on a shelf's [ press `p`: the oil lands."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.still",
      "lines": [
        {
          "speaker": "npc",
          "text": "Still! ...still.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "On the next shelf's [, press `p` again:\nthe same oil goes down again."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.knows-still",
          "value": true
        }
      ]
    },
    {
      "id": "warehouse.rope",
      "lines": [
        {
          "speaker": "system",
          "text": "Three coils. The bottom shelf is full."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.stocked",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every shelf. Copied, not carried.\nAnd the tally hasn't lost a drop."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "One thing at a time. Oil first, both shelves.\nThen the rope. My shelves, my rules."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Good. Now you know how it's done.\nSo does someone else."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every night someone fills these shelves with\ncopies, and wrong ones. Ask at customs."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "warehouse.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Behind the warehouse, the customs shed.\nTwo queues, two kinds of cargo."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "warehouse.start",
      "when": {
        "type": "stage-cleared",
        "stage": "jetty"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "port.warehouse"
        }
      ]
    },
    {
      "id": "warehouse.still-top",
      "when": {
        "type": "trigger",
        "trigger": "warehouse.top"
      },
      "once": false,
      "unless": "warehouse.knows-still",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "warehouse.still"
        }
      ]
    },
    {
      "id": "warehouse.still-middle",
      "when": {
        "type": "trigger",
        "trigger": "warehouse.middle"
      },
      "once": false,
      "unless": "warehouse.knows-still",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "warehouse.still"
        }
      ]
    },
    {
      "id": "warehouse.rope",
      "when": {
        "type": "trigger",
        "trigger": "warehouse.bottom"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "warehouse.rope"
        }
      ]
    },
    {
      "id": "warehouse.top",
      "when": {
        "type": "trigger",
        "trigger": "warehouse.top"
      },
      "once": true,
      "then": [
