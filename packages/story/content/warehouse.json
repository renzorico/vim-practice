{
  "worlds": [],
  "openingStage": "warehouse",
  "openingQuests": [],
  "quests": [
    {
      "id": "port.warehouse",
      "world": "copper-port",
      "title": "The warehouse",
      "kind": "main",
      "steps": [
        {
          "id": "stock",
          "objective": "Copy the tally onto the three shelves.",
          "completeWhen": {
            "type": "flag",
            "flag": "warehouse.stocked",
            "value": true
          },
          "then": []
        },
        {
          "id": "ream",
          "objective": "Report to the quartermaster.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "warehouse"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "warehouse.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The warehouse. Two tally racks,\nthree bare shelves."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "One of each, on the tally. All the stock\nthe port has left. The tally stays put."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "So you copy it. y yanks: it copies\nand takes nothing. yw copies one word."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "p puts it back, just after you.\nStand on a shelf's [ and p."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Oil on the top shelf and the middle one.\nRope on the bottom. Then come and see me."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.still",
      "lines": [
        {
          "speaker": "npc",
          "name": "Dot",
          "text": "Still! ...still."
        },
        {
          "speaker": "system",
          "text": "Dot means: the yank is still there.\np again puts the same thing again."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.knows-still",
          "value": true
        }
      ]
    },
    {
      "id": "warehouse.rope",
      "lines": [
        {
          "speaker": "system",
          "text": "Three coils. The bottom shelf is full."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.stocked",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every shelf. Copied, not carried.\nAnd the tally hasn't lost a drop."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "A yank holds one thing at a time.\nOil first, both shelves. Then the rope."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Good. Now you know how it's done.\nSo does someone else."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every night someone fills my shelves.\nCopies, and wrong ones. Ask at customs."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "warehouse.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Behind the warehouse, the customs shed.\nTwo queues, two kinds of cargo."
          }
        }
      ],
      "then": []
    }
  ],
