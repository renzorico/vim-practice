{
  "worlds": [],
  "openingStage": "warehouse",
  "openingQuests": [],
  "quests": [
    {
      "id": "port.warehouse",
      "world": "copper-port",
      "title": "Stock the shelves",
      "kind": "main",
      "steps": [
        {
          "id": "stock",
          "objective": "Copy oil onto the top and middle shelves, rope onto the bottom. y copies, p pastes.",
          "completeWhen": {
            "type": "flag",
            "flag": "warehouse.stocked",
            "value": true
          },
          "then": []
        },
        {
          "id": "ream",
          "objective": "Talk to Ream, the quartermaster. Stand next to him, press Enter.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "warehouse"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "warehouse.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The warehouse. Oil on the top rack, rope on the\nbottom, and three bare shelves to stock."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Copy, don't carry. y yanks: it copies and takes\nnothing. yw copies one word, like oooo."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "p puts it just after you. Stand on a shelf's [\nand press p. Oil: top, middle. Rope: bottom."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.still",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: the yank stays put. Press p again and the\nsame thing goes down again."
        },
        {
          "speaker": "npc",
          "text": "Still! ...still.",
          "name": "Dot"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.knows-still",
          "value": true
        }
      ]
    },
    {
      "id": "warehouse.rope",
      "lines": [
        {
          "speaker": "system",
          "text": "Three coils. The bottom shelf is full."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.stocked",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every shelf. Copied, not carried.\nAnd the tally hasn't lost a drop."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "A yank holds one thing at a time.\nOil first, both shelves. Then the rope."
        }
      ],
      "then": []
    },
    {
      "id": "warehouse.ream-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Good. Now you know how it's done.\nSo does someone else."
        },
        {
          "speaker": "npc",
          "name": "Ream",
          "text": "Every night someone fills my shelves.\nCopies, and wrong ones. Ask at customs."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "warehouse.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "warehouse.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Behind the warehouse, the customs shed.\nTwo queues, two kinds of cargo."
          }
        }
      ],
      "then": []
    }
  ],
