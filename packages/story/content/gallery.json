{
  "worlds": [],
  "openingStage": "gallery",
  "openingQuests": [],
  "quests": [
    {
      "id": "caves.gallery",
      "world": "echo-caves",
      "title": "Follow the echoed words",
      "kind": "main",
      "steps": [
        {
          "id": "follow",
          "objective": "Stand on a word and press * to jump to its next copy. Then w to the next word, and * again.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "gallery"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "gallery.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The echo gallery: words carved in sealed rooms,\nand every word said twice. Follow them."
        },
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "...ink. ...ink."
        },
        {
          "speaker": "scribe",
          "text": "Note: * jumps to the next copy of the\nword you stand on. # jumps back."
        }
      ],
      "then": []
    },
    {
      "id": "gallery.talk",
      "lines": [
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "Ink, map, key. The Scribe's three words,\nsaid on the way down."
        },
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "Below is the labyrinth. Something lives\nthere that doesn't like being looked for."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "gallery.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "gallery.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Below the gallery, the paths fork and fork.\nYou'll want to remember where you've been."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "gallery.start",
      "when": {
        "type": "stage-cleared",
        "stage": "mouth"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "caves.gallery"
        }
      ]
    },
    {
      "id": "gallery.talk",
      "when": {
        "type": "trigger",
        "trigger": "gallery.talk-echo"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "gallery.talk"
        }
      ]
    },
    {
      "id": "gallery.end",
      "when": {
        "type": "stage-cleared",
        "stage": "gallery"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "gallery.end"
        }
      ]
    }
  ]
}
