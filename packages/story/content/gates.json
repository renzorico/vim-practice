  "cutscenes": [
    {
      "id": "gates.end",
      "beats": [
        {
          "type": "title",
          "text": "Three. The Twin Gates swing open."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "The Scribe came through when we were one gate.\nLeft a line on the hinge. Look.",
            "name": "Ope"
          }
        },
        {
          "type": "title",
          "text": "The Scribe is in another buffer."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "Same as the others, they say.\nAnd a letter on the post: R.",
            "name": "Shut"
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "Attention. ...attention.",
            "name": "Dot"
          }
        }
      ],
      "then": [
        {
          "type": "light-statue",
          "letter": "R"
        }
      ]
