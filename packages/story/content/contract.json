      "lines": [
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "The founding contract. Every chain in the\nLibrary was written here first."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Change what's inside, not the brackets.\nci\" for quotes, ci( for brackets."
        },
        {
          "speaker": "npc",
          "name": "Index",
          "text": "One clause goes entirely. dap.\nAnd sign it. Not the Notary. You."
        },
        {
          "speaker": "system",
          "text": "The whole contract sits inside <contract>.\nStand on the tag you mean before cit."
        }
      ],
      "then": []
    }
  ],
