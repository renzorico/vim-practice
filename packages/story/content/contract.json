      "id": "contract.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "The founding contract. Our chains began here.\nYou need it rewritten before we can leave."
        },
        {
          "speaker": "system",
          "text": "Quotes: `ci\"`. Brackets: `ci(`. Clause: `dap`.\nSign it: stand on <name>, then `cit`."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "contract.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Quire",
            "text": "Read, dust, file, copy. All of it ours\nagain. And a name at the bottom."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Notary",
            "text": "The Minotaur. I wrote 'nothing guards them'\nbecause I was afraid to write the name."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Dot",
            "text": "Name! ...name."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Under the Library, the Echo Caves. A hoof, far\nbelow. Something is searching too."
          }
        },
        {
          "type": "line",
