    {
      "id": "lighthouse.lamplighter",
      "lines": [
        {
          "speaker": "npc",
          "text": "Who's there? He took a row of my light.\nI can't see the words to light it.",
          "name": "The Lamplighter"
        },
        {
          "speaker": "npc",
          "text": "Tilde? Then read them to me. Quick!\nThere. There... it catches.",
          "name": "The Lamplighter"
        }
      ],
