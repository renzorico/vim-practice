{
  "worlds": [],
  "quests": [
    {
      "id": "wordwood.glades",
      "world": "wordwood",
      "title": "Count the glades with Pilcrow",
      "kind": "main",
      "steps": [
        {
          "id": "floor",
          "objective": "Get down to Pilcrow on the forest floor. G jumps to the last row.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.asked",
            "value": true
          },
          "then": []
        },
        {
          "id": "lamp",
          "objective": "Light the lamp in the second glade. { climbs one glade at a time.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.lamp",
            "value": true
          },
          "then": []
        },
        {
          "id": "rope",
          "objective": "Pull the gate rope at the lookout, the top row. gg jumps there.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.rope",
            "value": true
          },
          "then": []
        },
        {
          "id": "gate",
          "objective": "Go back down to Pilcrow. G jumps to the last row.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "glades"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "glades.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The glades: a lookout above, thickets below,\nclearings between. Pilcrow waits at the bottom."
        },
        {
          "speaker": "scribe",
          "text": "Note: thickets are slow. An empty row is a\nclearing. } jumps to the next one, { back."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-ask",
      "lines": [
        {
          "speaker": "npc",
          "text": "Three glades, four thickets, one child.\nI count everything that comes down.",
          "name": "Pilcrow"
        },
        {
          "speaker": "npc",
          "text": "The gate is shut. Its rope is at the lookout,\nup top. The lamp in the second glade is dark.",
          "name": "Pilcrow"
        },
        {
          "speaker": "npc",
          "text": "Lamp first: two glades up from me. Press { to\nclimb one glade at a time.",
          "name": "Pilcrow"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.asked",
          "value": true
        }
      ]
    },
    {
      "id": "glades.pilcrow-lamp",
      "lines": [
        {
          "speaker": "npc",
          "text": "Two glades up. { then { again. Count them.\nI already have.",
          "name": "Pilcrow"
        }
      ],
      "then": []
    },
    {
      "id": "glades.lamp",
      "lines": [
        {
          "speaker": "system",
          "text": "You trim the wick. The glade lamp burns."
        },
        {
          "speaker": "scribe",
          "text": "Note: gg jumps to the first row, wherever you\nare. Here, that means the lookout."
        },
        {
          "speaker": "npc",
          "text": "Top! ...top.",
          "name": "Dot"
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "lamp-2"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lamp-2",
                "kind": "prop",
                "sprite": "lamp-lit",
                "at": {
                  "line": 8,
                  "col": 0
                },
                "behaviour": {
                  "type": "still"
                },
                "every": 1,
                "damage": 0,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "glades.lamp",
          "value": true
        }
      ]
    },
    {
      "id": "glades.pilcrow-rope",
      "lines": [
        {
          "speaker": "npc",
          "text": "Lamp's lit, one counted. Now the rope at the\nlookout. gg jumps you to the top row.",
          "name": "Pilcrow"
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-slack",
      "lines": [
        {
          "speaker": "system",
          "text": "A rope, tied off at the rail. Light the lamp\nbelow first, then come back to pull it."
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-pull",
      "lines": [
        {
          "speaker": "system",
          "text": "You haul the rope. Far below,\na gate groans open."
        },
        {
          "speaker": "scribe",
          "text": "Note: G is gg's twin: it jumps to the last row,\nthe forest floor. Go back down to Pilcrow."
        },
        {
          "speaker": "npc",
          "text": "Down! ...down.",
          "name": "Dot"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.rope",
          "value": true
        }
      ]
    },
    {
      "id": "glades.rope-done",
      "lines": [
        {
          "speaker": "system",
          "text": "The rope hangs loose. The gate is open."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-through",
      "lines": [
        {
          "speaker": "npc",
          "text": "One child: down, up, down again. Counted.",
          "name": "Pilcrow"
        },
        {
          "speaker": "npc",
          "text": "The Twin Gates are past the ferns. They\nwere one gate once. Before the Flicker.",
          "name": "Pilcrow"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.through",
          "value": true
        }
      ]
    },
    {
      "id": "glades.stump",
      "lines": [
        {
          "speaker": "system",
          "text": "Rings in the stump, one for every year\nup to the Last Saving. Then they stop."
        }
      ],
      "then": []
    },
    {
      "id": "glades.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Skip the thickets: } drops a glade, { climbs\none. gg jumps to the top, G to the floor."
        }
      ],
      "then": []
    }
  ],
