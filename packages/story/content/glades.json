{
  "worlds": [],
  "quests": [
    {
      "id": "wordwood.glades",
      "world": "wordwood",
      "title": "Count the glades with Pilcrow",
      "kind": "main",
      "steps": [
        {
          "id": "floor",
          "objective": "Get down to Pilcrow on the floor: `G`.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.asked",
            "value": true
          },
          "then": []
        },
        {
          "id": "lamp",
          "objective": "Light the lamp two glades up: `{`, then `{`.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.lamp",
            "value": true
          },
          "then": []
        },
        {
          "id": "rope",
          "objective": "Pull the rope at the lookout: `gg` jumps there.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.rope",
            "value": true
          },
          "then": []
        },
        {
          "id": "gate",
          "objective": "Go back down to Pilcrow: `G`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "glades"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "glades.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The glades. You need Pilcrow, at the bottom,\nto open the gate. Thickets in the way."
        },
        {
          "speaker": "system",
          "text": "Thickets are slow. Press `}`: you jump to the\nnext clearing (an empty row). `{` goes back."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-ask",
      "lines": [
        {
          "speaker": "npc",
          "text": "Three glades, four thickets, one child. I count\neverything that comes down. The gate's shut.",
          "name": "Pilcrow"
        },
        {
          "speaker": "npc",
          "text": "Its rope is at the lookout, up top. But the lamp\nin the second glade is dark. Lamp first.",
          "name": "Pilcrow"
        },
        {
          "speaker": "system",
          "text": "At the bottom, press `{` twice:\nyou climb two glades, up to the dark lamp."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.asked",
          "value": true
        }
      ]
    },
    {
      "id": "glades.pilcrow-lamp",
      "lines": [
        {
          "speaker": "npc",
          "text": "Two glades up. I've counted them twice.",
          "name": "Pilcrow"
        },
        {
          "speaker": "system",
          "text": "Press `{`, then `{` again."
        }
      ],
      "then": []
    },
    {
      "id": "glades.lamp",
      "lines": [
        {
          "speaker": "system",
          "text": "You trim the wick. The glade lamp burns."
        },
        {
          "speaker": "npc",
          "text": "Top! ...top.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Press `gg` to jump to the lookout, the top row."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "lamp-2"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lamp-2",
                "kind": "prop",
                "sprite": "lamp-lit",
                "at": {
                  "line": 8,
                  "col": 0
                },
                "behaviour": {
                  "type": "still"
                },
                "every": 1,
                "damage": 0,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "glades.lamp",
          "value": true
        }
      ]
    },
    {
      "id": "glades.pilcrow-rope",
      "lines": [
        {
          "speaker": "npc",
          "text": "Lamp's lit. One counted. Now the rope,\nup at the lookout.",
          "name": "Pilcrow"
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-slack",
      "lines": [
        {
          "speaker": "system",
          "text": "A rope, tied off at the rail. Light the lamp\nbelow first, then come back to pull it."
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-pull",
      "lines": [
        {
          "speaker": "system",
          "text": "You haul the rope. Far below,\na gate groans open."
        },
        {
          "speaker": "npc",
          "text": "Down! ...down.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Press `G`: you drop to the last row, the forest\nfloor, where Pilcrow waits."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.rope",
          "value": true
        }
      ]
    },
    {
      "id": "glades.rope-done",
      "lines": [
        {
          "speaker": "system",
          "text": "The rope hangs loose. The gate is open."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-through",
      "lines": [
        {
          "speaker": "npc",
          "text": "One child: down, up, down again. Counted twice.",
          "name": "Pilcrow"
        },
        {
          "speaker": "npc",
          "text": "The Twin Gates are past the ferns. They\nwere one gate once. Before the Flicker.",
          "name": "Pilcrow"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.through",
          "value": true
        }
      ]
    },
    {
      "id": "glades.stump",
      "lines": [
        {
          "speaker": "system",
          "text": "Rings in the stump, one for every year\nup to the Last Saving. Then they stop."
        }
      ],
      "then": []
    },
    {
      "id": "glades.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Skip the thickets: `}` drops a glade, `{` climbs\none. `gg` jumps to the top, `G` to the floor."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "glades.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Past the ferns, two gates face each other.\nNeither will open alone."
          }
        }
      ],
      "then": []
    }
  ],
