{
  "worlds": [],
  "quests": [
    {
      "id": "wordwood.glades",
      "world": "wordwood",
      "title": "Count the glades with Pilcrow",
      "kind": "main",
      "steps": [
        {
          "id": "floor",
          "objective": "Get down to Pilcrow on the floor: `G`.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.asked",
            "value": true
          },
          "then": []
        },
        {
          "id": "lamp",
          "objective": "Light the two dark lamps: `{`, then `2{` past the blot.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.lamp",
            "value": true
          },
          "then": []
        },
        {
          "id": "rope",
          "objective": "Pull the rope at the lookout: `gg` jumps there.",
          "completeWhen": {
            "type": "flag",
            "flag": "glades.rope",
            "value": true
          },
          "then": []
        },
        {
          "id": "gate",
          "objective": "Back down to Pilcrow: `G`, talk with `Enter`, then `}` to the gate.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "glades"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "glades.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The glades. You need Pilcrow, at the bottom,\nto open the gate. Thickets in the way."
        },
        {
          "speaker": "system",
          "text": "Thickets are slow. Press `}`: you jump to the\nnext clearing (an empty row). `{` goes back."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-ask",
      "lines": [
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "Three glades, four thickets, one child. I count\neverything that comes down. The gate's shut."
        },
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "Its rope is up at the lookout. But two lamps are\ndark: the next glade up, and the top glade."
        },
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "A blot sits in the middle glade. Press `{` once,\nthen `2{`: the count jumps right past it."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.asked",
          "value": true
        }
      ]
    },
    {
      "id": "glades.pilcrow-lamp",
      "lines": [
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "Two lamps dark. One glade up, then the top one."
        },
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "`{`, then `2{` past the blot."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-rope",
      "lines": [
        {
          "speaker": "npc",
          "text": "Lamp's lit. One counted. Now the rope,\nup at the lookout.",
          "name": "Pilcrow"
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-slack",
      "lines": [
        {
          "speaker": "system",
          "text": "A rope, tied off at the rail. Light both lamps\nbelow first, then come back to pull it."
        }
      ],
      "then": []
    },
    {
      "id": "glades.rope-pull",
      "lines": [
        {
          "speaker": "system",
          "text": "You haul the rope. Far below,\na gate groans open."
        },
        {
          "speaker": "npc",
          "text": "Down! ...down.",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Press `G`: you drop to the last row, the forest\nfloor, where Pilcrow waits."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.rope",
          "value": true
        }
      ]
    },
    {
      "id": "glades.rope-done",
      "lines": [
        {
          "speaker": "system",
          "text": "The rope hangs loose. The gate is open."
        }
      ],
      "then": []
    },
    {
      "id": "glades.pilcrow-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "One child: down, up, down again. Counted twice."
        },
        {
          "speaker": "npc",
          "name": "Pilcrow",
          "text": "The gate is at the far end of the floor. `}`\nruns to the end of the last glade."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.told",
          "value": true
        }
      ]
    },
    {
      "id": "glades.stump",
      "lines": [
        {
          "speaker": "system",
          "text": "Rings in the stump, one for every year\nup to the Last Saving. Then they stop."
        }
      ],
      "then": []
    },
    {
      "id": "glades.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Skip the thickets: `}` drops a glade, `{` climbs\none. `gg` jumps to the top, `G` to the floor."
        }
      ],
      "then": []
    },
    {
      "id": "glades.lamp-low",
      "lines": [
        {
          "speaker": "system",
          "text": "You trim the wick. The glade lamp burns."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "lamp-3"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lamp-3",
                "kind": "prop",
                "sprite": "lamp-lit",
                "at": {
                  "line": 13,
                  "col": 0
                },
                "behaviour": {
                  "type": "still"
                },
                "every": 1,
                "damage": 0,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "glades.lamp-low",
          "value": true
        }
      ]
    },
    {
      "id": "glades.lamp-top",
      "lines": [
        {
          "speaker": "system",
          "text": "The top glade lamp catches."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "lamp-1"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lamp-1",
                "kind": "prop",
                "sprite": "lamp-lit",
                "at": {
                  "line": 4,
                  "col": 0
                },
                "behaviour": {
                  "type": "still"
                },
                "every": 1,
                "damage": 0,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "glades.lamp-top",
          "value": true
        }
      ]
    },
    {
      "id": "glades.gate",
      "lines": [
        {
          "speaker": "system",
          "text": "Through the gate. The Twin Gates are past the\nferns. They were one gate once."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "glades.through",
          "value": true
        }
      ]
    },
    {
      "id": "glades.lamps-lit",
      "lines": [
        {
          "speaker": "system",
          "text": "Both lamps burn."
        },
        {
          "speaker": "npc",
          "name": "Dot",
          "text": "Top! ...top."
        },
        {
          "speaker": "system",
          "text": "Press `gg` to jump to the lookout, the top row."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "glades.end",
