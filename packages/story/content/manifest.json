        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Ferry's ready. The manifest isn't, and I don't\nsail on a wrong one. Fix it, please."
        },
        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Fix the title (one o too many), add the twins\nto the passengers, make the rope 4 coils."
        },
        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Strike the ink: it's banned on the water.\nAnd set 'Last checked' to today."
        }
      ],
      "then": []
    }
