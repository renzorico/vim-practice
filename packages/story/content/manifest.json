  "dialogues": [
    {
      "id": "manifest.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Ferry's ready. Manifest isn't.\nI don't sail on a wrong manifest."
        },
        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Title's misspelt. Twins aren't listed.\nRope's short. And someone wrote in ink."
        },
        {
          "speaker": "npc",
          "name": "Semi",
          "text": "Ink's banned on the water. Strike it.\nAnd the notes say last checked: never."
        },
        {
          "speaker": "system",
          "text": "Everything you learned in the Wordwood\nworks on text: f ; t % } G."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "manifest.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Semi",
            "text": "Right, then. On three, as the twins say."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Dot",
            "text": "Three! ...three."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "The ferry pulls out. Behind you, the\nWordwood. Ahead, the lights of Copper Port."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
