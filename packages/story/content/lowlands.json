{
  "worlds": [
    {
      "id": "lowlands",
      "order": 1,
      "name": "Lowlands",
      "stages": [
        "lowlands",
        "lighthouse"
      ],
      "castle": "lighthouse",
      "statue": "R"
    }
  ],
  "quests": [
    {
      "id": "lowlands.lighthouse",
      "world": "lowlands",
      "title": "Warn the Lighthouse",
      "kind": "main",
      "steps": [
        {
          "id": "cross",
          "objective": "Cross the blank field, stone to stone: `w`.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "lowlands.far-side"
          },
          "then": []
        },
        {
          "id": "lighthouse",
          "objective": "Reach the Lighthouse door along the jetty: `$`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "lowlands"
          },
          "then": []
        },
        {
          "id": "lamp",
          "objective": "Climb the Lighthouse to whoever is crying.",
          "completeWhen": {
            "type": "flag",
            "flag": "lighthouse.lit",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "openingStage": "lowlands",
  "openingQuests": [
    "lowlands.lighthouse"
  ],
  "cutscenes": [],
  "dialogues": [
    {
      "id": "lowlands.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Hop stone to stone with `w`.\nOn the jetty, `$` jumps to the door."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Lowlands. You need the Lighthouse, but the\nfield is wiped blank. Only stones are left."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.wren",
      "lines": [
        {
          "speaker": "npc",
          "text": "Sorry! Don't step there, it's blank. I lost a\nboot in it. And a sandwich.",
          "name": "Wren"
        },
        {
          "speaker": "system",
          "text": "Stand on the path, then on each stone.\nPress `w`: you hop to the next one."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-w",
          "value": true
        }
      ]
    },
    {
      "id": "lowlands.wren-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "Still no boot. I gave up on the sandwich.\nThe far side's east, past the last stone.",
          "name": "Wren"
        },
        {
          "speaker": "system",
          "text": "Overshot a stone? Press `b`:\nyou hop back to the one before."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.gull",
      "lines": [
        {
          "speaker": "npc",
          "text": "I've waited for the tide since the Flicker.\nIt won't come in. It won't go out. Rude.",
          "name": "Gull"
        },
        {
          "speaker": "npc",
          "text": "Maybe the sea isn't broken. Maybe it just\nisn't written yet. Anyway. I'm a gull.",
          "name": "Gull"
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Page 1. My little brother asked what's past\nthe sea. I wrote a jetty so he'd have to wait."
        },
        {
          "speaker": "system",
          "text": "Stand on the jetty's row, left of this note.\nPress `$`: you land at the Lighthouse door."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "scribe-note"
            }
          ]
        }
      ]
    },
    {
      "id": "lowlands.jetty",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots crawl up the jetty behind you."
        },
        {
          "speaker": "system",
          "text": "Press `$`: you jump to the door at the end\nof the row, and they can't follow."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-1",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 50
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 53
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "lowlands.end",
      "lines": [
        {
          "speaker": "system",
          "text": "The Lighthouse door. The lamp is dark and\nsomeone is crying inside. Go up the stairs."
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "lowlands.wren-edge",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.edge"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.wren"
        }
      ],
      "unless": "lowlands.knows-w"
    },
    {
      "id": "lowlands.wren-first",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.talk-wren"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.wren"
        }
      ],
      "unless": "lowlands.knows-w"
    },
    {
      "id": "lowlands.wren-repeat",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.talk-wren"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.wren-again"
        }
      ],
      "onlyIf": "lowlands.knows-w"
    },
    {
      "id": "lowlands.gull",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.talk-gull"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.gull"
        }
      ]
    },
    {
      "id": "lowlands.note",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.talk-note"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.note"
        }
      ]
    },
    {
      "id": "lowlands.jetty",
      "when": {
        "type": "trigger",
        "trigger": "lowlands.jetty"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.jetty"
        }
      ]
    },
    {
      "id": "lowlands.cleared",
      "when": {
        "type": "stage-cleared",
        "stage": "lowlands"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "lowlands.end"
        }
      ]
    }
  ]
}
