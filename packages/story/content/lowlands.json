  "openingStage": "lowlands",
  "openingQuests": [
    "lowlands.lighthouse"
  ],
  "cutscenes": [],
  "dialogues": [
    {
      "id": "lowlands.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "East of the Margin, the Lowlands.\nOr what the Unwriter left of them."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.wren",
      "lines": [
        {
          "speaker": "npc",
          "text": "Wait! Don't step in that. It's blank.\nWhere the Unwriter walks, land goes blank.",
          "name": "Wren"
        },
        {
          "speaker": "npc",
          "text": "You can't walk on blank. But you can\nleap it. w jumps to the next word.",
          "name": "Wren"
        },
        {
          "speaker": "npc",
          "text": "Each stone is a word. w: next stone.\nb: back one. The blank is skipped.",
          "name": "Wren"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-w",
          "value": true
        }
      ]
    },
    {
      "id": "lowlands.wren-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "w forward, b back. Stone to stone.",
          "name": "Wren"
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.gull",
      "lines": [
        {
          "speaker": "npc",
          "text": "The tide's not coming in tonight.\nIt's not going out either.",
          "name": "Gull"
        },
        {
          "speaker": "npc",
          "text": "Maybe it's not the world that's broken.\nMaybe it's just not written yet.",
          "name": "Gull"
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "I left a note for you, whoever you are.\n$ jumps to the end of the line."
        },
        {
          "speaker": "scribe",
          "text": "The jetty is one long line. One key.\nAnd 0 jumps back to the start of it."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        }
      ]
    },
    {
      "id": "lowlands.jetty",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots crawl up the jetty from the sea.\nThe door is at the end of the line."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-1",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 7,
                  "col": 50
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 7,
                  "col": 53
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "lowlands.end",
      "lines": [
        {
          "speaker": "system",
          "text": "The Lighthouse. Its lamp is dark.\nSomething is moving inside."
        }
      ],
      "then": []
    }
  ],
