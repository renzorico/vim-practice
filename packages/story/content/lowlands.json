  "quests": [
    {
      "id": "lowlands.lighthouse",
      "world": "lowlands",
      "title": "Warn the Lighthouse",
      "kind": "main",
      "steps": [
        {
          "id": "cross",
          "objective": "Cross the blank field. Stand on a stone, press w to hop to the next.",
          "completeWhen": {
            "type": "trigger",
            "trigger": "lowlands.far-side"
          },
          "then": []
        },
        {
          "id": "lighthouse",
          "objective": "Reach the Lighthouse door at the end of the jetty. $ jumps to the end of the row.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "lowlands"
          },
          "then": []
        },
        {
          "id": "lamp",
          "objective": "Climb the Lighthouse stairs. Find who is crying at the top.",
          "completeWhen": {
            "type": "flag",
            "flag": "lighthouse.lit",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "openingStage": "lowlands",
  "openingQuests": [
    "lowlands.lighthouse"
  ],
  "cutscenes": [],
  "dialogues": [
    {
      "id": "lowlands.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Press w to hop stone to stone. On the jetty,\npress $ to jump to the door."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Lowlands: the Unwriter wiped the field.\nOnly the stepping stones are left. Cross them."
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.wren",
      "lines": [
        {
          "speaker": "npc",
          "text": "Sorry! Sorry, don't step there, it's blank.\nI lost a boot in it. And a sandwich.",
          "name": "Wren"
        },
        {
          "speaker": "npc",
          "text": "Sorry, you can't walk on blank. But you can\nleap it. Each stone is a word. w: next one.",
          "name": "Wren"
        },
        {
          "speaker": "npc",
          "text": "b jumps back one. Sorry, I keep saying sorry.\nCross to the far side, then follow the jetty.",
          "name": "Wren"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-w",
          "value": true
        }
      ]
    },
    {
      "id": "lowlands.wren-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "Sorry! w is forward, b is back, stone to stone.\nThe far side is east. Sorry, sorry.",
          "name": "Wren"
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.gull",
      "lines": [
        {
          "speaker": "npc",
          "text": "Look. The tide isn't coming in tonight.\nIt isn't going out either. Rude.",
          "name": "Gull"
        },
        {
          "speaker": "npc",
          "text": "Maybe the sea isn't broken. Maybe it just\nisn't written yet. Anyway. I'm a gull.",
          "name": "Gull"
        }
      ],
      "then": []
    },
    {
      "id": "lowlands.note",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: this jetty is one long row. You could\npress l forty times. Or press $ once."
        },
        {
          "speaker": "scribe",
          "text": "Note: $ jumps to the end of a row, 0 back to\nits start. Try $ now."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "scribe-note"
            }
          ]
        }
      ]
    },
    {
      "id": "lowlands.jetty",
      "lines": [
        {
          "speaker": "system",
          "text": "Blots crawl up the jetty! The door is at the\nend of this row. Press $ to jump there."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "lowlands.knows-dollar",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-1",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 50
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "lowlands.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 53
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 1,
                "damage": 1,
                "solid": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "lowlands.end",
      "lines": [
        {
          "speaker": "system",
          "text": "The Lighthouse door. The lamp is dark and\nsomeone is crying inside. Go up."
        }
      ],
      "then": []
    }
  ],
