{
  "worlds": [
    {
      "id": "library",
      "order": 5,
      "name": "The Library",
      "stages": [
        "stacks",
        "reading",
        "archive",
        "notary",
        "contract"
      ],
      "castle": "notary",
      "statue": "Q"
    }
  ],
  "openingStage": "stacks",
  "openingQuests": [],
  "quests": [
    {
      "id": "library.stacks",
      "world": "library",
      "title": "Dust the shelves",
      "kind": "main",
      "steps": [
        {
          "id": "dust",
          "objective": "Dust the three shelves. Stand on a dust word, press daw. Then j and . for the next shelf.",
          "completeWhen": {
            "type": "flag",
            "flag": "stacks.dusted",
            "value": true
          },
          "then": []
        },
        {
          "id": "quire",
          "objective": "Talk to Quire, the librarian. Stand next to Quire, press Enter.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "stacks"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "stacks.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Library: chained doors, dusty shelves. Dust\nhas been shelved between the books."
        },
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "Quire, librarian. The contract says I may not\ntouch a book, so I can't dust. You can."
        },
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "Stand on a dust word and press daw: it deletes\nthe word and the space after it. Three shelves."
        }
      ],
      "then": []
    },
    {
      "id": "stacks.down",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: after daw, j moves one shelf down and .\nrepeats your last change: the same daw again."
        },
        {
          "speaker": "npc",
          "name": "Dot",
          "text": "Down! ...down."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "stacks.knows-dot",
          "value": true
        }
      ]
    },
    {
      "id": "stacks.dusted",
      "lines": [
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "Clean. Every shelf, one word at a time."
        }
      ],
      "then": []
    },
    {
      "id": "stacks.quire-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "Three shelves. Stand on a dust word, press daw.\nI'm not allowed to, you see."
        }
      ],
      "then": []
    },
    {
      "id": "stacks.quire-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "The contract says I may not dust.\nIt doesn't say you can't."
        },
        {
          "speaker": "npc",
          "name": "Quire",
          "text": "The reading room is chained, bracket to\nbracket. Bring your %."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "stacks.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "stacks.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Past the stacks, the reading room.\nChains across the floor, ( to )."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "stacks.start",
      "when": {
        "type": "stage-cleared",
        "stage": "harbour"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "library.stacks"
        }
      ]
    },
    {
      "id": "stacks.down-1",
      "when": {
        "type": "trigger",
        "trigger": "stacks.shelf-1"
      },
      "once": false,
      "unless": "stacks.knows-dot",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "stacks.down"
        }
      ]
    },
    {
      "id": "stacks.down-2",
      "when": {
        "type": "trigger",
        "trigger": "stacks.shelf-2"
      },
      "once": false,
      "unless": "stacks.knows-dot",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "stacks.down"
        }
      ]
    },
    {
      "id": "stacks.shelf-1",
      "when": {
        "type": "trigger",
        "trigger": "stacks.shelf-1"
      },
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "stacks.shelf-1",
          "value": true
        }
      ]
    },
    {
      "id": "stacks.shelf-2",
      "when": {
