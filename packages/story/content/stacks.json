          "type": "set-flag",
          "flag": "stacks.shelf-2",
          "value": true
        }
      ]
    },
    {
      "id": "stacks.shelf-3",
      "when": {
        "type": "trigger",
        "trigger": "stacks.shelf-3"
      },
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "stacks.shelf-3",
          "value": true
        }
      ]
    },
    {
      "id": "stacks.upper-1",
      "when": {
