    {
      "id": "stacks.upper-2",
      "when": {
        "type": "flag",
        "flag": "stacks.shelf-2",
        "value": true
      },
      "once": true,
      "onlyIf": "stacks.shelf-1",
      "then": [
        {
          "type": "set-flag",
          "flag": "stacks.upper",
          "value": true
        }
      ]
    },
    {
      "id": "stacks.dusted-upper",
      "when": {
        "type": "flag",
        "flag": "stacks.upper",
        "value": true
      },
      "once": true,
      "onlyIf": "stacks.shelf-3",
      "then": [
        {
          "type": "set-flag",
