    },
    {
      "id": "stacks.quire-wait",
      "when": {
        "type": "trigger",
        "trigger": "stacks.talk-quire"
      },
      "once": false,
      "unless": "stacks.dusted",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "stacks.quire-wait"
        }
      ]
    },
    {
      "id": "stacks.quire-through",
      "when": {
        "type": "trigger",
        "trigger": "stacks.talk-quire"
