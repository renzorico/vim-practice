{
  "worlds": [],
  "openingStage": "reading",
  "openingQuests": [],
  "quests": [
    {
      "id": "library.reading",
      "world": "library",
      "title": "Unchain the reading room",
      "kind": "main",
      "steps": [
        {
          "id": "chains",
          "objective": "Lift three chains: `da(`, and `d2a(` for the nested one.",
          "completeWhen": {
            "type": "flag",
            "flag": "reading.chains-gone",
            "value": true
          },
          "then": []
        },
        {
          "id": "folio",
          "objective": "Talk to Folio: next to Folio, `Enter`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "reading"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "reading.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Folio, reader. Chains hold this room, and me,\neach shackled ( to ). Free us, I'll guide you."
        },
        {
          "speaker": "system",
          "text": "Stand inside a chain. Press `da(`: chain and\nshackles go. Folio's own chain: `di(` instead."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Mind the blot between the first two chains.\n`w` jumps over it; walking steps onto it."
        }
      ],
      "then": []
    },
    {
      "id": "reading.nested",
      "lines": [
        {
          "speaker": "npc",
          "name": "Dot",
          "text": "Open! ...open."
        },
        {
          "speaker": "system",
          "text": "Stand on the outer ( of the double chain.\nPress `d2a(`: both chains go."
        }
      ],
      "then": []
    },
    {
      "id": "reading.folio-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Chains first, please. I'm not going anywhere.\nLiterally."
        }
      ],
      "then": []
    },
    {
      "id": "reading.folio-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Free hands. And an open shackle,\nin case I need to be stubborn again."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "The archive is next. The contract misfiled a\nwhole shelf in the middle of it."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "reading.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "reading.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Past the reading room, the archive: shelves of\nrows, with an empty row between shelves."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "reading.start",
      "when": {
        "type": "stage-cleared",
        "stage": "stacks"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "library.reading"
        }
      ]
    },
    {
      "id": "reading.nested",
      "when": {
        "type": "trigger",
        "trigger": "reading.first-gone"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.nested"
        }
      ]
    },
    {
      "id": "reading.chains-gone",
      "when": {
        "type": "trigger",
        "trigger": "reading.chains-gone"
      },
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "reading.chains-gone",
          "value": true
        }
      ]
    },
    {
      "id": "reading.folio-wait",
      "when": {
        "type": "trigger",
        "trigger": "reading.talk-folio"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.folio-wait"
        }
      ],
      "unless": "reading.chains-gone"
    },
    {
      "id": "reading.folio-through",
      "when": {
        "type": "trigger",
        "trigger": "reading.talk-folio"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.folio-through"
        }
      ],
      "onlyIf": "reading.chains-gone"
    },
    {
      "id": "reading.end",
      "when": {
        "type": "stage-cleared",
        "stage": "reading"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "reading.end"
        }
      ]
    }
  ]
}
