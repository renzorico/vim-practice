{
  "worlds": [],
  "openingStage": "reading",
  "openingQuests": [],
  "quests": [
    {
      "id": "library.reading",
      "world": "library",
      "title": "Unchain the reading room",
      "kind": "main",
      "steps": [
        {
          "id": "chains",
          "objective": "Lift the three chains: stand inside each and press da(. Use d2a( for the nested one.",
          "completeWhen": {
            "type": "flag",
            "flag": "reading.chains-gone",
            "value": true
          },
          "then": []
        },
        {
          "id": "folio",
          "objective": "Talk to Folio at the far end. Press Enter next to Folio.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "reading"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "reading.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The reading room. Chains lie across the floor,\neach held by a pair of shackles, ( and )."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Folio, reader, chained to my chair. Stand in a\nchain and press da(: chain and shackles go."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "The last chain is mine: use di(. It takes the\nchain and leaves the shackle. I may need it."
        }
      ],
      "then": []
    },
    {
      "id": "reading.nested",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: a chain inside a chain? d2a( takes both.\nThe whole room is clear after that."
        },
        {
          "speaker": "npc",
          "name": "Dot",
          "text": "Open! ...open."
        }
      ],
      "then": []
    },
    {
      "id": "reading.folio-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Chains first. Anywhere inside, da(."
        }
      ],
      "then": []
    },
    {
      "id": "reading.folio-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "Free hands. And an open shackle,\nin case I need to be stubborn again."
        },
        {
          "speaker": "npc",
          "name": "Folio",
          "text": "The archive is next. The contract misfiled a\nwhole shelf in the middle of it."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "reading.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "reading.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Past the reading room, the archive: shelves of\nrows, with an empty row between shelves."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "reading.start",
      "when": {
        "type": "stage-cleared",
        "stage": "stacks"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "library.reading"
        }
      ]
    },
    {
      "id": "reading.nested",
      "when": {
        "type": "trigger",
        "trigger": "reading.first-gone"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.nested"
        }
      ]
    },
    {
      "id": "reading.chains-gone",
      "when": {
        "type": "trigger",
        "trigger": "reading.chains-gone"
      },
      "once": true,
      "then": [
        {
          "type": "set-flag",
          "flag": "reading.chains-gone",
          "value": true
        }
      ]
    },
    {
      "id": "reading.folio-wait",
      "when": {
        "type": "trigger",
        "trigger": "reading.talk-folio"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.folio-wait"
        }
      ],
      "unless": "reading.chains-gone"
    },
    {
      "id": "reading.folio-through",
      "when": {
        "type": "trigger",
        "trigger": "reading.talk-folio"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "reading.folio-through"
        }
      ],
      "onlyIf": "reading.chains-gone"
    },
    {
      "id": "reading.end",
      "when": {
        "type": "stage-cleared",
        "stage": "reading"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "reading.end"
        }
      ]
    }
  ]
}
