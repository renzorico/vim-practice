  "dialogues": [
    {
      "id": "margin.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "You wake in the Margin. This morning a whole\nrow of the village is gone. Your house too."
        },
        {
          "speaker": "system",
          "text": "The Elder is shouting for you.\nWalk to him: `h` `j` `k` `l`, then `Enter`."
        }
      ],
      "then": []
    },
    {
      "id": "margin.elder",
      "lines": [
        {
          "speaker": "elder",
          "text": "The Unwriter came again last night, child.\nThe north field went, and the festival lamps."
        },
        {
          "speaker": "elder",
          "text": "Someone must warn the Lighthouse, east along\nthe road. Or we're all unsaved. Unsaved!"
        },
        {
          "speaker": "system",
          "text": "Blots swarm the road. Go south to the well.\nStand next to Mira and press `Enter`."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.met-elder",
          "value": true
        }
      ]
    },
    {
      "id": "margin.elder-again",
      "lines": [
        {
          "speaker": "elder",
          "text": "No lamps, so candles. The festival goes ahead,\nunsaved or not. Go on, child."
        },
        {
          "speaker": "system",
          "text": "Mira is at the well, south of here.\nStand next to her and press `Enter`."
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira-early",
      "lines": [
        {
          "speaker": "npc",
          "text": "Morning, Tilde. The Elder's looking for you.\nGo see him first. He's in a state.",
          "name": "Mira"
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira",
      "lines": [
        {
          "speaker": "npc",
          "text": "We were three on this well wall once. You,\nme and... never mind. Bram's left, road's clear.",
          "name": "Mira"
        },
        {
          "speaker": "npc",
          "text": "Blots take a step every time you do. So don't\ntake thirty steps. Take one move.",
          "name": "Mira"
        },
        {
          "speaker": "system",
          "text": "Stand on the road, past the wall.\nPress `30l`: you cross to the gate in one move."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.knows-counts",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "bram"
            }
          ]
        }
      ]
    },
    {
      "id": "margin.mira-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "Still two on the wall. Funny, it keeps room\nfor a third.",
          "name": "Mira"
        },
        {
          "speaker": "system",
          "text": "Stand on the road. Press `30l`:\nthe Blots can't keep up."
        }
      ],
      "then": []
    },
    {
      "id": "margin.pell",
      "lines": [
        {
          "speaker": "npc",
          "text": "I knit my brother a scarf every winter. He left\nbefore the Last Saving. We don't say his name.",
          "name": "Pell"
        },
        {
          "speaker": "npc",
          "text": "Out there, unsaved things just fade. Mind the\nroad, child. Take the scarf. Wool lasts.",
          "name": "Pell"
        }
      ],
      "then": []
    },
    {
      "id": "margin.bram",
      "lines": [
        {
          "speaker": "npc",
          "text": "Road's closed. Blots everywhere. I've been on\nthis shift since sunrise. I want my bed.",
          "name": "Bram"
        },
        {
          "speaker": "npc",
          "text": "Ask Mira. She crossed it once. Don't ask how.",
          "name": "Bram"
        }
      ],
      "then": []
    },
    {
      "id": "margin.road",
      "lines": [
        {
          "speaker": "system",
          "text": "Ink bubbles up out of the fields: Blots.\nThey step every time you step."
        },
        {
          "speaker": "system",
          "text": "Press `30l` on the road: one move, and you're\npast all of them."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "spawn",
              "entity": {
                "id": "margin.blot-1",
