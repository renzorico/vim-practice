  "dialogues": [
    {
      "id": "margin.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "You wake in the Margin, at the edge of\nthe world. Someone is calling your name."
        },
        {
          "speaker": "elder",
          "text": "Tilde! Over here!\nWalk with h j k l: left, down, up, right."
        }
      ],
      "then": []
    },
    {
      "id": "margin.elder",
      "lines": [
        {
          "speaker": "elder",
          "text": "The Unwriter came again last night.\nThe north field is gone. Row by row."
        },
        {
          "speaker": "elder",
          "text": "Someone must warn the Lighthouse.\nThe road east is the only way there."
        },
        {
          "speaker": "elder",
          "text": "But the road is crawling with Blots.\nMira at the well knows a trick. Go."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.met-elder",
          "value": true
        }
      ]
    },
    {
      "id": "margin.elder-again",
      "lines": [
        {
          "speaker": "elder",
          "text": "Mira is at the well, south of here."
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira-early",
      "lines": [
        {
          "speaker": "npc",
          "text": "Morning, Tilde. The Elder was looking\nfor you. Better see him first.",
          "name": "Mira"
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira",
      "lines": [
        {
          "speaker": "npc",
          "text": "Blots move when you move. Every step\nyou take, they take one too.",
          "name": "Mira"
        },
        {
          "speaker": "npc",
          "text": "So take fewer steps. Don't press l\nthirty times. Type 30l: one move.",
          "name": "Mira"
        },
        {
          "speaker": "npc",
          "text": "A number before a key repeats it.\n5j, 3h, 30l. Bram will let you pass.",
          "name": "Mira"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.knows-counts",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "bram"
            }
          ]
        }
      ]
    },
    {
      "id": "margin.mira-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "A number, then the key. 30l.\nThe Blots won't even blink.",
          "name": "Mira"
        }
      ],
      "then": []
    },
    {
      "id": "margin.pell",
      "lines": [
        {
          "speaker": "npc",
          "text": "My brother left before the Last Saving.\nWe never said his name again.",
          "name": "Pell"
        },
        {
          "speaker": "npc",
          "text": "Out there, unsaved things just... fade.\nMind the road, child.",
          "name": "Pell"
        }
      ],
      "then": []
    },
    {
      "id": "margin.bram",
      "lines": [
        {
          "speaker": "npc",
          "text": "Road's closed. Blots everywhere.\nOne step at a time, they'd swarm you.",
          "name": "Bram"
        },
        {
          "speaker": "npc",
          "text": "Ask Mira. She crossed it once.",
          "name": "Bram"
        }
      ],
      "then": []
    },
    {
      "id": "margin.road",
      "lines": [
        {
          "speaker": "system",
          "text": "Ink bubbles up from the fields.\nBlots! Remember Mira: one big move."
        }
