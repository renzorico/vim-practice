  "dialogues": [
    {
      "id": "margin.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "You're Tilde, in the Margin, the last edge of\nthe world. Someone is shouting your name."
        },
        {
          "speaker": "elder",
          "text": "Child! Here! Walk to me: h left, j down,\nk up, l right. Then press Enter to talk."
        }
      ],
      "then": []
    },
    {
      "id": "margin.elder",
      "lines": [
        {
          "speaker": "elder",
          "text": "Child... the Unwriter came again last night.\nThe north field is gone. Row by row."
        },
        {
          "speaker": "elder",
          "text": "Someone must warn the Lighthouse, east along\nthe road. Or we are all unsaved. Unsaved!"
        },
        {
          "speaker": "elder",
          "text": "Blots swarm the road. Mira, at the well,\nsouth of here, knows a trick. Go, child."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.met-elder",
          "value": true
        }
      ]
    },
    {
      "id": "margin.elder-again",
      "lines": [
        {
          "speaker": "elder",
          "text": "Child, Mira waits at the well, south of here.\nStand next to her and press Enter."
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira-early",
      "lines": [
        {
          "speaker": "npc",
          "text": "Morning, Tilde. The Elder's been looking for\nyou. Go see him first, he's in a state.",
          "name": "Mira"
        }
      ],
      "then": []
    },
    {
      "id": "margin.mira",
      "lines": [
        {
          "speaker": "npc",
          "text": "Blots take one step every time you do.\nSo don't take thirty. Keep up, Tilde.",
          "name": "Mira"
        },
        {
          "speaker": "npc",
          "text": "Put a number before a key: 30l walks\nright thirty tiles in one move.",
          "name": "Mira"
        },
        {
          "speaker": "npc",
          "text": "Any number works: 5j, 3h, 30l. I sent Bram\nhome, so the road east is open.",
          "name": "Mira"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "margin.knows-counts",
          "value": true
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "bram"
            }
          ]
        }
      ]
    },
    {
      "id": "margin.mira-again",
      "lines": [
        {
          "speaker": "npc",
          "text": "A number, then the key: 30l.\nThe Blots can't keep up. Go on.",
          "name": "Mira"
        }
      ],
      "then": []
    },
    {
      "id": "margin.pell",
      "lines": [
        {
          "speaker": "npc",
          "text": "My brother left before the Last Saving.\nWe never said his name again. Anyway.",
          "name": "Pell"
        },
        {
          "speaker": "npc",
          "text": "Out there, unsaved things just... fade.\nMind the road, child. Take a scarf.",
          "name": "Pell"
        }
      ],
      "then": []
    },
    {
      "id": "margin.bram",
      "lines": [
        {
          "speaker": "npc",
          "text": "Road's closed. Blots everywhere. You step,\nthey step. I'm not paid enough for this.",
          "name": "Bram"
        },
        {
          "speaker": "npc",
          "text": "Ask Mira. She crossed it once. Don't ask how.",
          "name": "Bram"
        }
      ],
      "then": []
    },
    {
      "id": "margin.road",
      "lines": [
        {
          "speaker": "system",
          "text": "Ink bubbles up from the fields. Blots!\nThey step when you step. Use 30l, one move."
        }
      ],
      "then": [
