{
  "worlds": [
    {
      "id": "echo-caves",
      "order": 6,
      "name": "The Echo Caves",
      "stages": [
        "mouth",
        "gallery",
        "marked",
        "labyrinth",
        "study"
      ],
      "castle": "labyrinth",
      "statue": "A"
    }
  ],
  "openingStage": "mouth",
  "openingQuests": [],
  "quests": [
    {
      "id": "caves.mouth",
      "world": "echo-caves",
      "title": "Light the crystals",
      "kind": "main",
      "steps": [
        {
          "id": "crystals",
          "objective": "Light the three sealed crystals, deepest first: ?x then Enter, then n.",
          "completeWhen": {
            "type": "flag",
            "flag": "mouth.top",
            "value": true
          },
          "then": []
        },
        {
          "id": "echo",
          "objective": "Talk to the Echo beside the top crystal. Press Enter next to it.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "mouth"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "mouth.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The Echo Caves. Too dark to see anything, and\nthe crystals are sealed in the rock."
        },
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "...study. ...study."
        },
        {
          "speaker": "scribe",
          "text": "Note: ?x then Enter searches backward for an x\n(a crystal). n repeats it: the next one up."
        }
      ],
      "then": []
    },
    {
      "id": "mouth.lit-deep",
      "lines": [
        {
          "speaker": "system",
          "text": "The deepest crystal wakes."
        }
      ],
      "then": []
    },
    {
      "id": "mouth.lit-middle",
      "lines": [
        {
          "speaker": "system",
          "text": "The middle crystal answers it."
        }
      ],
      "then": []
    },
    {
      "id": "mouth.lit-top",
      "lines": [
        {
          "speaker": "system",
          "text": "The top crystal. And beside it, someone."
        }
      ],
      "then": []
    },
    {
      "id": "mouth.echo-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "...deepest first. ...deepest first."
        }
      ],
      "then": []
    },
    {
      "id": "mouth.echo-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "You found me without seeing me. That's how\nthe Scribe found things too."
        },
        {
          "speaker": "npc",
          "name": "Echo",
          "text": "The Scribe's words echo through the gallery.\nFollow the right one."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "mouth.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "mouth.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Past the mouth, the echo gallery.\nThe same word, over and over, in the dark."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "mouth.start",
      "when": {
        "type": "stage-cleared",
        "stage": "contract"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "caves.mouth"
        }
      ]
    },
    {
      "id": "mouth.deep",
      "when": {
        "type": "trigger",
        "trigger": "mouth.deep"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "mouth.lit-deep"
        },
        {
          "type": "set-flag",
          "flag": "mouth.deep",
          "value": true
        }
      ]
    },
    {
      "id": "mouth.middle",
      "when": {
        "type": "trigger",
        "trigger": "mouth.middle"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "mouth.lit-middle"
        },
        {
          "type": "set-flag",
          "flag": "mouth.middle",
          "value": true
        }
      ]
    },
    {
      "id": "mouth.top",
      "when": {
        "type": "trigger",
        "trigger": "mouth.top"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "mouth.lit-top"
        },
        {
          "type": "set-flag",
          "flag": "mouth.top",
          "value": true
        }
      ]
    },
    {
      "id": "mouth.echo-wait",
      "when": {
        "type": "trigger",
        "trigger": "mouth.talk-echo"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "mouth.echo-wait"
        }
      ],
      "unless": "mouth.top"
    },
    {
      "id": "mouth.echo-through",
      "when": {
        "type": "trigger",
        "trigger": "mouth.talk-echo"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "mouth.echo-through"
        }
      ],
      "onlyIf": "mouth.top"
    },
    {
      "id": "mouth.end",
      "when": {
        "type": "stage-cleared",
        "stage": "mouth"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "mouth.end"
        }
      ]
    }
  ]
}
