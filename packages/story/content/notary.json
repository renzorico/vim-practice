{
  "worlds": [],
  "openingStage": "notary",
  "openingQuests": [],
  "quests": [
    {
      "id": "library.notary",
      "world": "library",
      "title": "Open the vault",
      "kind": "main",
      "steps": [
        {
          "id": "open",
          "objective": "Open three locks: `da[`, `da{`, `dit`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "notary"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "notary.intro",
      "lines": [
        {
          "speaker": "npc",
          "name": "Notary",
          "text": "Notary. A clause every two turns. At seven the\nvault shuts for good. You need it open: hurry."
        },
        {
          "speaker": "system",
          "text": "In a lock, press `da[`. In a seal, `da{`.\nIn a tag, `dit`. Three locks, in that order."
        }
      ],
      "then": []
    },
    {
      "id": "notary.fuse",
      "lines": [
        {
          "speaker": "npc",
          "name": "Notary",
          "text": "Seven. Signed and sealed."
        },
        {
          "speaker": "system",
          "text": "The vault door settles into its frame."
        }
      ],
      "then": []
    },
    {
      "id": "notary.open",
      "lines": [
        {
          "speaker": "npc",
          "name": "Notary",
          "text": "Unlocked. Unsealed. Emptied.\nNone of that was in the contract."
        }
      ],
      "then": []
    },
    {
      "id": "notary.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "In the lock, `da[`. Then `0` `2j` `w` and `da{`.\nAgain `0` `2j` `w`, then `dit` for the tag."
        }
      ],
      "then": []
    }
  ],
  "cutscenes": [
    {
      "id": "notary.end",
      "beats": [
        {
          "type": "title",
          "text": "The vault stands open. One clause on the\nwall, older than all of his."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Notary",
            "text": "In case of loss, recover. The Scribe's own hand.\nBefore the Flicker."
          }
        },
        {
          "type": "title",
          "text": "The Scribe is in another buffer."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Notary",
            "text": "The Scribe left a letter on my desk: Q. I\nfiled it under quit. I was wrong."
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "name": "Dot",
            "text": "Recover. ...recover."
          }
        }
      ],
      "then": [
        {
          "type": "light-statue",
          "letter": "Q"
        }
      ]
    }
  ],
  "reactions": [
    {
      "id": "notary.start",
      "when": {
        "type": "stage-cleared",
        "stage": "archive"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "library.notary"
        }
      ]
    },
    {
      "id": "notary.open",
      "when": {
        "type": "trigger",
        "trigger": "notary.open"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "notary.open"
        },
        {
          "type": "set-flag",
          "flag": "notary.through",
          "value": true
        }
      ]
    },
    {
      "id": "notary.fuse",
      "when": {
        "type": "trigger",
        "trigger": "notary.fuse"
      },
      "once": false,
      "unless": "notary.through",
      "then": [
        {
          "type": "dialogue",
          "dialogue": "notary.fuse"
        },
        {
          "type": "world",
          "effects": [
            {
              "type": "hit",
              "hearts": 3
            }
          ]
        }
      ]
    },
    {
      "id": "notary.end",
      "when": {
        "type": "stage-cleared",
        "stage": "notary"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "notary.end"
        }
      ]
    }
  ]
