{
  "worlds": [],
  "openingStage": "customs",
  "openingQuests": [],
  "quests": [
    {
      "id": "port.customs",
      "world": "copper-port",
      "title": "Customs",
      "kind": "main",
      "steps": [
        {
          "id": "oil",
          "objective": "Clear the nets, then put oil in the first crate. Copy with yw, paste with \"0p.",
          "completeWhen": {
            "type": "flag",
            "flag": "customs.oil",
            "value": true
          },
          "then": []
        },
        {
          "id": "mixed",
          "objective": "Put oil, then rope, in the second crate. Keep the rope safe with \"byw, paste it with \"bp.",
          "completeWhen": {
            "type": "flag",
            "flag": "customs.mixed",
            "value": true
          },
          "then": []
        },
        {
          "id": "tare",
          "objective": "Talk to Tare, the customs officer. Press Enter next to Tare.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "customs"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "customs.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The customs shed. Two crates, one officer,\nand a pile of nets in the way."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Tare, customs. First crate: oil. Second crate:\noil, then rope. The nets block the first one."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Delete the nets first (db). Then copy the oil\nwith yw and put it in with p. Cleared."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "A register is a named hold: \"b before yw yanks\ninto b, \"bp puts it back. Rope's down by you."
        }
      ],
      "then": []
    },
    {
      "id": "customs.nets-gone",
      "lines": [
        {
          "speaker": "scribe",
          "text": "Note: d keeps what it deletes, so p would now\nput the nets back. Not what you want."
        },
        {
          "speaker": "npc",
          "text": "Gone! ...gone.",
          "name": "Dot"
        },
        {
          "speaker": "scribe",
          "text": "Note: \"0 keeps your last yank, whatever you\ndelete after it. \"0p puts it."
        }
      ],
      "then": []
    },
    {
      "id": "customs.oil",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Oil. Cleared."
        }
      ],
      "then": []
    },
    {
      "id": "customs.mixed",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Oil, then rope. In that order. Cleared."
        }
      ],
      "then": []
    },
    {
      "id": "customs.tare-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Both crates. Oil in the first.\nOil, then rope, in the second."
        }
      ],
      "then": []
    },
    {
      "id": "customs.tare-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Clean work. You kept your copy safe while the\nnets went overboard. Cleared."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "The copies on Ream's shelves came through\nhere. The clerk learned to copy too."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "He lost the row that said which crates\nwere real. Now he copies everything."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "customs.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "customs.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Behind customs, the old counting house.\nThe clerk's lamp is still lit."
          }
        }
      ],
      "then": []
    }
  ],
