{
  "worlds": [],
  "openingStage": "customs",
  "openingQuests": [],
  "quests": [
    {
      "id": "port.customs",
      "world": "copper-port",
      "title": "Customs",
      "kind": "main",
      "steps": [
        {
          "id": "oil",
          "objective": "Oil in the crate past the nets: `db`, `yw`, `\"0p`.",
          "completeWhen": {
            "type": "flag",
            "flag": "customs.oil",
            "value": true
          },
          "then": []
        },
        {
          "id": "mixed",
          "objective": "Oil, then rope, in the O+R crate: `\"byw`, `\"bp`.",
          "completeWhen": {
            "type": "flag",
            "flag": "customs.mixed",
            "value": true
          },
          "then": []
        },
        {
          "id": "tare",
          "objective": "Talk to Tare: next to Tare, `Enter`.",
          "completeWhen": {
            "type": "stage-cleared",
            "stage": "customs"
          },
          "then": []
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "customs.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The customs shed. You need two crates cleared by\nTare, and a pile of nets blocks the first."
        },
        {
          "speaker": "system",
          "text": "Nets first: stand just past them, press `db`.\nThen `yw` on oil, `\"0p` on the crate's end."
        },
        {
          "speaker": "system",
          "text": "A blot sits on the middle floor by the crate.\n`f[` jumps past it; walking stops on it."
        }
      ],
      "then": []
    },
    {
      "id": "customs.nets-gone",
      "lines": [
        {
          "speaker": "npc",
          "text": "Gone! ...gone.",
          "name": "Dot"
        },
        {
          "speaker": "scribe",
          "text": "Deletes and copies share one pocket. I once\npasted my shopping list into a letter. Twice."
        },
        {
          "speaker": "system",
          "text": "Press `yw` on the oil. Then `\"0p` on the crate's\nend: plain `p` would put the nets back."
        }
      ],
      "then": []
    },
    {
      "id": "customs.oil",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Oil. Cleared."
        }
      ],
      "then": []
    },
    {
      "id": "customs.mixed",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Oil, then rope. In that order. Cleared."
        }
      ],
      "then": []
    },
    {
      "id": "customs.tare-wait",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Both crates. Oil in the first.\nOil, then rope, in the second."
        }
      ],
      "then": []
    },
    {
      "id": "customs.tare-through",
      "lines": [
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "Clean work. Nets overboard, copy safe, labels\nright. Cleared."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "The copies on Ream's shelves came through\nhere. The clerk learned to copy too."
        },
        {
          "speaker": "npc",
          "name": "Tare",
          "text": "He lost the row that said which crates\nwere real. Now he copies everything."
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "customs.through",
          "value": true
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "customs.end",
      "beats": [
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "Behind customs, the old counting house.\nThe clerk's lamp is still lit."
          }
        }
      ],
      "then": []
    }
  ],
  "reactions": [
