{
  "worlds": [],
  "quests": [
    {
      "id": "quarry.mason",
      "world": "quarry",
      "title": "The Mason's Shaft",
      "kind": "main",
      "steps": [
        {
          "id": "mason",
          "objective": "Get down to the Mason.",
          "completeWhen": {
            "type": "flag",
            "flag": "shaft.mason-cured",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "openingStage": "shaft",
  "openingQuests": [],
  "dialogues": [
    {
      "id": "shaft.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "The road ends at a shaft. Far below,\nsomeone is laying stone, row on row."
        }
      ],
      "then": []
    },
    {
      "id": "shaft.lip",
      "lines": [
        {
          "speaker": "npc",
          "text": "WHO'S UP THERE? Go back! I'm not done!\nEvery row I lay, I lay for a reason.",
          "name": "The Mason"
        },
        {
          "speaker": "system",
          "text": "Climb down and his mortar throws you\nback. Stay up here. Bring the shaft to you."
        },
        {
          "speaker": "npc",
          "text": "Again! ...again!",
          "name": "Dot"
        },
        {
          "speaker": "system",
          "text": "Dot means: . repeats your last change.\n3dd once, then . as often as you like."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "mason-idle"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "mason",
                "kind": "keeper",
                "sprite": "mason",
                "at": {
                  "line": 14,
                  "col": 4
                },
                "behaviour": {
                  "type": "build",
                  "rows": [
                    ".........",
                    ".........",
                    ".........",
                    ".........",
                    ".........",
                    "........."
                  ]
                },
                "every": 2,
                "damage": 0,
                "solid": true
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-0",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 7,
                  "col": 1
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-1",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 9,
                  "col": 7
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 2
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-3",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 13,
                  "col": 6
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "shaft.knows-dot",
          "value": true
        }
      ]
    },
    {
      "id": "shaft.thrown",
      "lines": [
        {
          "speaker": "system",
          "text": "Wet mortar! It flings you back up.\nDon't climb down. Delete your way down."
        }
      ],
      "then": []
    },
    {
      "id": "shaft.mason",
      "lines": [
        {
          "speaker": "npc",
          "text": "You came down. Nobody comes down.",
          "name": "The Mason"
        },
        {
          "speaker": "npc",
          "text": "Walls. I build walls. There was a door\nin the plan once. A door in a wall.",
          "name": "The Mason"
        },
        {
          "speaker": "npc",
          "text": "A row is missing from my plan. The one\nthat says what the walls were for.",
          "name": "The Mason"
        },
        {
          "speaker": "system",
          "text": "You tell him what you have seen: a lamp\nrelit, a road reopened, a cage opened."
        },
        {
          "speaker": "npc",
          "text": "...Opened. A wall with a way through.\nA door! I've been building it wrong.",
          "name": "The Mason"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "shaft.mason-cured",
          "value": true
        }
      ]
    },
    {
      "id": "shaft.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "dd brings the shaft up to you. Count:\n2dd swallows a Blot below you. . repeats."
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "shaft.start",
      "when": {
        "type": "stage-cleared",
        "stage": "cut"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "quarry.mason"
        },
        {
          "type": "unlock-stage",
          "stage": "shaft"
        }
      ]
    },
    {
      "id": "shaft.lip",
      "when": {
        "type": "trigger",
        "trigger": "shaft.lip"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.lip"
        }
      ]
    },
    {
      "id": "shaft.thrown",
      "when": {
        "type": "trigger",
        "trigger": "shaft.down"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.thrown"
        }
      ]
    },
    {
      "id": "shaft.throw-back",
      "when": {
        "type": "trigger",
        "trigger": "shaft.down"
      },
      "once": false,
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "move-player",
              "to": {
                "line": 2,
                "col": 4
              }
            }
          ]
        }
      ]
    },
    {
      "id": "shaft.mason",
      "when": {
        "type": "trigger",
        "trigger": "shaft.talk-mason"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.mason"
        }
      ],
      "unless": "shaft.mason-cured"
    },
    {
      "id": "shaft.cleared",
      "when": {
        "type": "stage-cleared",
        "stage": "shaft"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "shaft.end"
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "shaft.end",
      "beats": [
        {
          "type": "title",
          "text": "The Mason laughs. The shaft is quiet."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "The Scribe came through here. Carved\nsomething in my bottom stone. Look.",
            "name": "The Mason"
          }
        },
        {
          "type": "title",
          "text": "The Scribe is in another buffer."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "Another buffer. Same words the Lamplighter\nfound, I'd bet. And a letter: E.",
            "name": "The Mason"
          }
        },
        {
          "type": "line",
          "line": {
            "speaker": "system",
            "text": "End of World 2."
          }
        }
      ],
      "then": [
        {
          "type": "light-statue",
          "letter": "E"
        }
      ]
    }
  ]
}