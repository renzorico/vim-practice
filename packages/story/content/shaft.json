{
  "worlds": [],
  "quests": [
    {
      "id": "quarry.mason",
      "world": "quarry",
      "title": "The Mason's Shaft",
      "kind": "main",
      "steps": [
        {
          "id": "mason",
          "objective": "Reach the Mason: `10dd` at the lip, then talk.",
          "completeWhen": {
            "type": "flag",
            "flag": "shaft.mason-cured",
            "value": true
          },
          "then": []
        }
      ]
    }
  ],
  "openingStage": "shaft",
  "openingQuests": [],
  "dialogues": [
    {
      "id": "shaft.intro",
      "lines": [
        {
          "speaker": "system",
          "text": "You need the Mason, at the bottom of this shaft.\nWalk to the lip: `j` `j`. Then look down."
        }
      ],
      "then": []
    },
    {
      "id": "shaft.lip",
      "lines": [
        {
          "speaker": "npc",
          "text": "WHO'S UP THERE? Go back! I'm not done!\nEvery row I lay, I lay for a reason.",
          "name": "The Mason"
        },
        {
          "speaker": "system",
          "text": "Stay at the lip. Press `10dd`: ten rows go and\nthe shaft rises. Or `3dd`, then `.` each time."
        }
      ],
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "remove-entity",
              "entity": "mason-idle"
            },
            {
              "type": "spawn",
              "entity": {
                "id": "mason",
                "kind": "keeper",
                "sprite": "mason",
                "at": {
                  "line": 14,
                  "col": 4
                },
                "behaviour": {
                  "type": "build",
                  "rows": [
                    ".........",
                    ".........",
                    ".........",
                    ".........",
                    ".........",
                    "........."
                  ]
                },
                "every": 2,
                "damage": 0,
                "solid": true
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-0",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 7,
                  "col": 1
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-1",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 9,
                  "col": 7
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-2",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 11,
                  "col": 2
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            },
            {
              "type": "spawn",
              "entity": {
                "id": "shaft.blot-3",
                "kind": "blot",
                "sprite": "blot",
                "at": {
                  "line": 13,
                  "col": 6
                },
                "behaviour": {
                  "type": "chase"
                },
                "every": 2,
                "damage": 1,
                "solid": false
              }
            }
          ]
        },
        {
          "type": "set-flag",
          "flag": "shaft.knows-dot",
          "value": true
        }
      ]
    },
    {
      "id": "shaft.thrown",
      "lines": [
        {
          "speaker": "system",
          "text": "Wet mortar! It flings you back up to the lip.\nDon't climb. Pull the shaft up to you."
        }
      ],
      "then": []
    },
    {
      "id": "shaft.mason",
      "lines": [
        {
          "speaker": "npc",
          "text": "You came down? Nobody comes down. I build\nwalls. A row's missing: what they're for.",
          "name": "The Mason"
        },
        {
          "speaker": "system",
          "text": "You tell him what you did: a lamp lit, a\nroad cleared, a cage opened."
        },
        {
          "speaker": "npc",
          "text": "A cage, opened. A wall with a way through.\nA door! I've been building it wrong.",
          "name": "The Mason"
        }
      ],
      "then": [
        {
          "type": "set-flag",
          "flag": "shaft.mason-cured",
          "value": true
        }
      ]
    },
    {
      "id": "shaft.death-hint",
      "lines": [
        {
          "speaker": "system",
          "text": "Stay at the lip. `10dd` deletes ten rows and the\nshaft rises. Then `Enter` next to the Mason."
        }
      ],
      "then": []
    }
  ],
  "reactions": [
    {
      "id": "shaft.start",
      "when": {
        "type": "stage-cleared",
        "stage": "cut"
      },
      "once": true,
      "then": [
        {
          "type": "start-quest",
          "quest": "quarry.mason"
        },
        {
          "type": "unlock-stage",
          "stage": "shaft"
        }
      ]
    },
    {
      "id": "shaft.lip",
      "when": {
        "type": "trigger",
        "trigger": "shaft.lip"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.lip"
        }
      ]
    },
    {
      "id": "shaft.thrown",
      "when": {
        "type": "trigger",
        "trigger": "shaft.down"
      },
      "once": true,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.thrown"
        }
      ]
    },
    {
      "id": "shaft.throw-back",
      "when": {
        "type": "trigger",
        "trigger": "shaft.down"
      },
      "once": false,
      "then": [
        {
          "type": "world",
          "effects": [
            {
              "type": "move-player",
              "to": {
                "line": 2,
                "col": 4
              }
            }
          ]
        }
      ]
    },
    {
      "id": "shaft.mason",
      "when": {
        "type": "trigger",
        "trigger": "shaft.talk-mason"
      },
      "once": false,
      "then": [
        {
          "type": "dialogue",
          "dialogue": "shaft.mason"
        }
      ],
      "unless": "shaft.mason-cured"
    },
    {
      "id": "shaft.cleared",
      "when": {
        "type": "stage-cleared",
        "stage": "shaft"
      },
      "once": true,
      "then": [
        {
          "type": "cutscene",
          "cutscene": "shaft.end"
        }
      ]
    }
  ],
  "cutscenes": [
    {
      "id": "shaft.end",
      "beats": [
        {
          "type": "title",
          "text": "The Mason laughs. First time in years, he says."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "The Scribe came through. Carved something\nin my bottom stone. Look.",
            "name": "The Mason"
          }
        },
        {
          "type": "title",
          "text": "The Scribe is in another buffer."
        },
        {
          "type": "line",
          "line": {
            "speaker": "npc",
            "text": "Same words the Lamplighter found, I'd bet.\nAnd a letter beside them: E.",
            "name": "The Mason"
          }
        }
      ],
      "then": [
        {
          "type": "light-statue",
          "letter": "E"
        }
      ]
    }
  ]
}
