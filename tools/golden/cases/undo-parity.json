      "lines": [
        "<contract>",
        "one",
        "two",
        "</contract>"
      ],
      "cursor": [
        0,
        9
      ],
      "mode": "n"
    }
  },
  {
    "name": "cat over lines then undo cursor",
    "lines": [
      "x",
      "<b>",
      "one",
      "</b>",
      "y"
    ],
    "cursor": [
      2,
      1
    ],
    "keys": "catZ<Esc>u",
