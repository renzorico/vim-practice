  {
    "name": "db on an empty line then undo",
    "lines": [
      "abc def",
      ""
    ],
    "cursor": [
      0,
      4
    ],
    "keys": "xjdbu",
    "expect": {
      "lines": [
        "abc ef",
        ""
      ],
      "cursor": [
        0,
        4
      ],
      "mode": "n"
    }
  },
  {
    "name": "d0 from mid line then undo",
    "lines": [
      "abc def"
    ],
    "cursor": [
      0,
      4
    ],
    "keys": "d0u",
    "expect": {
      "lines": [
