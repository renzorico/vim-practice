[
  {
    "name": "empty quotes then undo keeps the x",
    "lines": [
      "ab",
      "\"\""
    ],
    "cursor": [
      0,
      0
    ],
    "keys": "xjlldi\"u",
    "expect": {
      "lines": [
        "b",
        "\"\""
      ],
      "cursor": [
        1,
        1
      ],
      "mode": "n"
    }
  },
  {
    "name": "empty tag then undo keeps the x",
    "lines": [
      "ab",
      "<a></a>"
    ],
    "cursor": [
      0,
      0
    ],
    "keys": "xjllditu",
    "expect": {
      "lines": [
        "b",
        "<a></a>"
      ],
      "cursor": [
        1,
        3
      ],
      "mode": "n"
    }
  },
